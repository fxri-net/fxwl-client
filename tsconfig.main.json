{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*"],
  // 用例由 vitest 单独运行，不进入主进程类型检查
  "exclude": ["src/__tests__/**/*"],
  "compilerOptions": {
    "composite": true,
    // 主进程与 preload 跑在 Electron 22 内置的 Node 16 上，类型面锁在 ES2021
    "target": "ES2021",
    "lib": ["ES2021"],
    // Electron 22 不支持 ESM 主进程，产物由 electron-vite 按 CJS 输出
    "module": "CommonJS",
    "moduleResolution": "node",
    // electron-vite/node 提供 `?asset` 等构建期导入的类型声明
    "types": ["node", "electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  }
}
