{
  "name": "@fxri/fxwl-client",
  "version": "2.1.4",
  "private": true,
  "description": "网页程序桌面展示终端：安装后填入网页地址即可获得开机自启、全屏置顶与悬浮导航。",
  "license": "Apache-2.0",
  "author": {
    "name": "唐启云",
    "email": "tqy@fxri.net",
    "url": "https://fxri.net:444/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxri-net/fxwl-client.git"
  },
  "bugs": {
    "url": "https://github.com/fxri-net/fxwl-client/issues"
  },
  "homepage": "https://fxri-net.github.io/fxwl-client/",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:main && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "node scripts/toolkit.mjs changelog",
    "changelog:version": "node scripts/toolkit.mjs changelog version",
    "changelog:format": "node scripts/toolkit.mjs changelog format",
    "sync:changelog-doc": "node scripts/toolkit.mjs changelog doc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify": "node scripts/verify.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config",
    "build:win-shell": "electron-builder --win --config",
    "build:mac-shell": "electron-builder --mac --config",
    "build:linux-shell": "electron-builder --linux --config"
  },
  "keywords": [
    "fxwl-client",
    "electron",
    "desktop",
    "kiosk",
    "fxri"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.4",
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-store": "^8.1.0",
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@types/http-server": "^0.12.1",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.15",
    "electron": "22.3.27",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "pinia": "^3.0.4",
    "postcss": "^8.4.29",
    "prettier": "^3.9.10",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  }
}
